# Copy to .env and fill in — NEVER commit the real .env
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# MongoDB Atlas M0 (free) — create at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/netbook

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Gmail SMTP for verification/reset codes — needs an App Password
# Google Account → Security → 2FA on → App Passwords → Mail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Google OAuth client ID — Google Cloud Console → APIs & Services → Credentials
# Must match the client's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Redis (optional) — feed/search/explore cache. Falls back to an in-process
# cache when unset, so nothing breaks without it.
# Free options: `docker compose up` includes redis, or Upstash/Redis Cloud free tier
REDIS_URL=

# Web Push (VAPID) — offline notifications. Generate once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Semantic search — MiniLM embeddings run locally (free, no API key).
# Set ATLAS_VECTOR_INDEX to your Atlas Vector Search index name to use
# $vectorSearch instead of the built-in in-app cosine path.
# Set SEMANTIC_SEARCH=off to disable the feature entirely.
SEMANTIC_SEARCH=
ATLAS_VECTOR_INDEX=

# Protect /api/metrics on public deploys (Prometheus scrape endpoint)
METRICS_TOKEN=
