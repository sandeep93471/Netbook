# Copy to .env
# API base — in dev the Vite proxy already maps /api + /socket.io to the server,
# so this is only needed if you point at a remote server.
VITE_API_URL=

# Cloudinary unsigned upload preset — Cloudinary dashboard → Settings → Upload presets
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google OAuth — same client ID as server's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
